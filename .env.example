# Copy to .env and fill in. .env is never committed.

# Sessions: AUTH_SECRET signs the sign-in cookie; generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
SESSION_TTL_HOURS=24
# true when the site is served over HTTPS
COOKIE_SECURE=false

# Encrypts provider API keys before they are stored; generate one with
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it: stored keys cannot be read back with a different one.
ENCRYPTION_KEY=

# Database (docker compose uses the same values for the local PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=masterly
DB_USER=masterly
DB_PASSWORD=masterly

# File storage: "local" keeps files under STORAGE_LOCAL_DIR, "s3" uses the bucket
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=data/files
# S3_BUCKET=
# AWS_REGION=
